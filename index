<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mockup Prompt Generator — Johanna Digital Seattle</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --coral:#E8635A;--teal:#5BAB9F;--yellow:#F5C842;
  --pink:#F0A0A0;--pink-wash:#F9E8E2;--dark:#2C1810;
  --cream:#FDF4F0;--white:#fff;--gray:#7a6960;--border:#F2D5CC;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',sans-serif;background:var(--cream);min-height:100vh;overflow-x:hidden}

/* HEADER */
.hdr-wrap{max-width:860px;margin:0 auto;padding:20px 20px 0}
.hdr{background:var(--coral);padding:0;position:relative;overflow:hidden;border-radius:18px;border:2px solid #D4554D;box-shadow:0 6px 28px rgba(232,99,90,.22)}
.hdr-inner{padding:40px 28px 36px;position:relative;z-index:2}
.hdr::before{content:'';position:absolute;top:-50px;right:-50px;width:280px;height:280px;background:#fff;border-radius:50%;opacity:.08}
.hdr::after{content:'';position:absolute;bottom:-60px;left:8%;width:200px;height:200px;background:var(--yellow);border-radius:50%;opacity:.18}
.hdr-tag{display:inline-block;background:rgba(255,255,255,.22);color:#fff;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:5px 14px;border-radius:40px;margin-bottom:14px;border:1.5px solid rgba(255,255,255,.35)}
.hdr h1{font-family:'Playfair Display',serif;font-size:clamp(26px,5vw,44px);font-weight:900;color:#fff;line-height:1.15;margin-bottom:10px}
.hdr h1 em{color:var(--yellow);font-style:normal}
.hdr p{font-size:14px;color:rgba(255,255,255,.85);line-height:1.7;max-width:520px}
.dots{display:flex;gap:8px;margin-top:18px}
.dot{width:10px;height:10px;border-radius:50%}

/* MAIN */
.main{max-width:820px;margin:0 auto;padding:28px 20px 60px}

/* STEP LABEL */
.step-label{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.step-num{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff;flex-shrink:0}
.sn1{background:var(--coral)}.sn2{background:var(--teal)}.sn3{background:var(--yellow);color:var(--dark)}
.sn4{background:var(--pink);color:var(--dark)}.sn5{background:var(--coral)}.sn6{background:var(--teal)}.sn7{background:var(--dark)}
.step-title{font-size:15px;font-weight:700;color:var(--dark)}
.step-sub{font-size:11px;color:var(--gray)}

/* CARD */
.card{background:#fff;border-radius:20px;padding:24px;margin-bottom:18px;border:1.5px solid var(--border);box-shadow:0 2px 16px rgba(232,99,90,.06);animation:up .35s ease both}
@keyframes up{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.card:nth-child(1){animation-delay:.04s}.card:nth-child(2){animation-delay:.08s}
.card:nth-child(3){animation-delay:.12s}.card:nth-child(4){animation-delay:.16s}
.card:nth-child(5){animation-delay:.20s}.card:nth-child(6){animation-delay:.24s}
.divider{border:none;border-top:2px solid var(--pink-wash);margin-bottom:18px}

/* GRIDS */
.g2{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.g5{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
@media(max-width:520px){.g3,.g4,.g5{grid-template-columns:repeat(2,1fr)}.g2{grid-template-columns:1fr}}

/* OPTION BUTTON */
.opt{padding:12px 8px;border-radius:12px;border:2px solid #e8ddd9;background:#fff;cursor:pointer;transition:all .18s;text-align:center;font-family:'DM Sans',sans-serif;width:100%}
.opt:hover{border-color:var(--coral);background:#FEF0EE}
.opt.on{border-color:var(--coral);background:#FEF0EE;box-shadow:0 0 0 3px rgba(232,99,90,.13)}
.opt-ico{font-size:22px;margin-bottom:5px;display:block}
.opt-lbl{font-size:12px;font-weight:600;color:var(--dark);line-height:1.3;display:block}
.opt-sub{font-size:10px;color:var(--gray);display:block;margin-top:2px}

/* DYNAMIC SECTION */
.dyn{display:none}.dyn.show{display:block}

/* CUSTOM SIZE */
.cbox{margin-top:14px;padding:16px;background:var(--pink-wash);border-radius:12px;border:1.5px dashed #E0A89E;display:none}
.cbox.show{display:block}
.crow{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap}
.ig{flex:1;min-width:70px}
.ig label{display:block;font-size:11px;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.07em;margin-bottom:4px}
.ig input{width:100%;padding:9px 11px;border-radius:9px;border:1.5px solid #e0d4cf;font-size:14px;font-family:'DM Sans',sans-serif;outline:none;background:#fff;color:var(--dark)}
.ig input:focus{border-color:var(--coral)}
.sep{font-size:16px;color:var(--gray);padding-bottom:8px;font-weight:700}
.utog{display:flex;border-radius:9px;overflow:hidden;border:1.5px solid #e0d4cf}
.ubtn{padding:9px 14px;font-size:13px;font-weight:600;cursor:pointer;border:none;font-family:'DM Sans',sans-serif;background:#fff;color:var(--gray);transition:all .2s}
.ubtn.on{background:var(--coral);color:#fff}
.cres{margin-top:10px;padding:9px 13px;background:#fff;border-radius:8px;border:1.5px solid var(--teal);font-size:13px;color:var(--teal);font-weight:600;display:none}
.cres.show{display:block}

/* SHIRT COLORS */
.swatch-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:4px}
.swatch{width:38px;height:38px;border-radius:50%;border:3px solid transparent;cursor:pointer;transition:all .2s;position:relative}
.swatch.on{border-color:var(--dark);transform:scale(1.15)}
.swatch-label{font-size:10px;color:var(--gray);text-align:center;margin-top:3px;display:block;width:38px}

/* SKIN ROW */
.skin-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}
.skin{width:36px;height:36px;border-radius:50%;border:3px solid transparent;cursor:pointer;transition:all .2s}
.skin.on{border-color:var(--dark);transform:scale(1.15)}

/* PLATFORM PILLS */
.pill-row{display:flex;flex-wrap:wrap;gap:8px}
.pill{padding:8px 18px;border-radius:40px;border:2px solid #e8ddd9;background:#fff;cursor:pointer;font-size:13px;font-weight:600;color:var(--gray);transition:all .18s;font-family:'DM Sans',sans-serif}
.pill:hover{border-color:var(--coral);color:var(--coral)}
.pill.on{border-color:var(--coral);background:var(--coral);color:#fff}

/* SECTION MINI LABEL */
.mlbl{font-size:11px;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px;display:block}

/* GEN BUTTON */
.gen-wrap{text-align:center;margin:24px 0 0}
.gen-btn{display:inline-flex;align-items:center;gap:10px;background:var(--coral);color:#fff;font-family:'Playfair Display',serif;font-size:18px;font-weight:700;padding:18px 52px;border-radius:60px;border:none;cursor:pointer;transition:all .25s;box-shadow:0 6px 28px rgba(232,99,90,.38);position:relative;overflow:hidden}
.gen-btn:hover{transform:translateY(-2px);box-shadow:0 10px 36px rgba(232,99,90,.48);filter:brightness(1.05)}
.gen-btn span{position:relative;z-index:1}

/* RESULTS */
.results{margin-top:28px;display:none}
.results.show{display:block}
.res-hdr{text-align:center;margin-bottom:22px}
.res-hdr h2{font-family:'Playfair Display',serif;font-size:26px;font-weight:900;color:var(--dark)}
.res-hdr p{font-size:13px;color:var(--gray);margin-top:4px}

.pcard{border-radius:20px;padding:24px;margin-bottom:16px;position:relative}
.pc-g{background:#EDF7F6;border:2px solid var(--teal)}
.pc-gr{background:#FEF0EE;border:2px solid var(--coral)}
.pc-mj{background:#2C1810;border:2px solid var(--yellow)}

.pbadge{display:inline-flex;align-items:center;gap:6px;padding:4px 13px;border-radius:40px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:12px}
.bg-t{background:var(--teal);color:#fff}
.bg-c{background:var(--coral);color:#fff}
.bg-y{background:var(--yellow);color:var(--dark)}

.ptitle{font-size:14px;font-weight:700;color:var(--dark);margin-bottom:2px}
.pc-mj .ptitle{color:#fff}
.pdesc{font-size:12px;color:var(--gray);margin-bottom:12px}
.pc-mj .pdesc{color:rgba(255,255,255,.5)}

.ptext{background:#fff;border-radius:11px;padding:15px;font-size:12.5px;line-height:1.8;color:#333;white-space:pre-wrap;word-break:break-word;border:1.5px solid rgba(0,0,0,.06);margin-bottom:12px}
.pc-mj .ptext{background:rgba(255,255,255,.07);color:rgba(255,255,255,.9);border-color:rgba(255,255,255,.1)}

.cpbtn{display:inline-flex;align-items:center;gap:7px;padding:10px 22px;border-radius:40px;font-size:13px;font-weight:700;cursor:pointer;border:none;font-family:'DM Sans',sans-serif;transition:all .2s}
.cp-t{background:var(--teal);color:#fff}
.cp-c{background:var(--coral);color:#fff}
.cp-y{background:var(--yellow);color:var(--dark)}
.cpbtn:hover{opacity:.85;transform:translateY(-1px)}

.footer{max-width:860px;margin:0 auto;padding:0 20px 24px}
.footer-inner{border-top:1px solid var(--border);padding-top:16px;text-align:center}
.footer-name{font-size:13px;font-weight:700;background:linear-gradient(90deg,var(--coral),var(--teal));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;display:inline-block;margin-bottom:8px}
.footer-follow{font-size:10px;color:var(--gray);text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px}
.footer-socials{display:flex;justify-content:center;gap:8px;margin-bottom:10px}
.fsoc{display:inline-flex;align-items:center;gap:5px;padding:5px 14px;border-radius:40px;border:1.5px solid var(--border);background:#fff;font-size:11px;font-weight:600;color:var(--gray);text-decoration:none;transition:border-color .2s,color .2s}
.fsoc:hover{border-color:var(--coral);color:var(--coral)}
.footer-legal{font-size:10px;color:#bbb;line-height:1.8}
.footer-legal a{color:var(--coral);text-decoration:none}
.footer-legal a:hover{text-decoration:underline}
</style>
</head>
<body>

<div class="hdr-wrap">
<div class="hdr">
  <div class="hdr-inner">
    <div class="hdr-tag">✦ Johanna Digital Seattle</div>
    <h1>Mockup Prompt<br><em>Generator</em></h1>
    <p>Genera prompts hiperrealistas para cualquier producto. Compatible con Gemini, Grok, ChatGPT y Midjourney.</p>
    <div class="dots">
      <div class="dot" style="background:#fff;opacity:.9"></div>
      <div class="dot" style="background:var(--yellow)"></div>
      <div class="dot" style="background:#fff;opacity:.5"></div>
      <div class="dot" style="background:var(--teal)"></div>
    </div>
  </div>
</div>
</div>

<div class="main">

  <!-- STEP 1: PRODUCT TYPE -->
  <div class="card">
    <div class="step-label"><div class="step-num sn1">1</div><div><div class="step-title">Tipo de producto</div><div class="step-sub">¿Qué producto vas a mostrar?</div></div></div>
    <hr class="divider">
    <div class="g4">
      <button class="opt on" onclick="selProd(this,'notebook')"><span class="opt-ico">📓</span><span class="opt-lbl">Cuaderno</span><span class="opt-sub">Notebook KDP</span></button>
      <button class="opt" onclick="selProd(this,'book')"><span class="opt-ico">📗</span><span class="opt-lbl">Libro</span><span class="opt-sub">Book KDP</span></button>
      <button class="opt" onclick="selProd(this,'tshirt')"><span class="opt-ico">👕</span><span class="opt-lbl">Camiseta</span><span class="opt-sub">T-shirt</span></button>
      <button class="opt" onclick="selProd(this,'hoodie')"><span class="opt-ico">🧥</span><span class="opt-lbl">Hoodie</span><span class="opt-sub">Sudadera</span></button>
      <button class="opt" onclick="selProd(this,'mug')"><span class="opt-ico">☕</span><span class="opt-lbl">Taza</span><span class="opt-sub">Mug</span></button>
      <button class="opt" onclick="selProd(this,'sticker')"><span class="opt-ico">🪧</span><span class="opt-lbl">Sticker</span><span class="opt-sub">Die cut</span></button>
      <button class="opt" onclick="selProd(this,'totebag')"><span class="opt-ico">🛍️</span><span class="opt-lbl">Tote Bag</span><span class="opt-sub">Bolsa</span></button>
      <button class="opt" onclick="selProd(this,'candle')"><span class="opt-ico">🕯️</span><span class="opt-lbl">Vela</span><span class="opt-sub">Candle</span></button>
    </div>
  </div>

  <!-- STEP 2: PLATFORM -->
  <div class="card">
    <div class="step-label"><div class="step-num sn2">2</div><div><div class="step-title">Plataforma de destino</div><div class="step-sub">¿Dónde vas a usar este mockup?</div></div></div>
    <hr class="divider">
    <div class="pill-row">
      <button class="pill on" onclick="selPill(this,'platform','amazon')">Amazon KDP</button>
      <button class="pill" onclick="selPill(this,'platform','etsy')">Etsy</button>
      <button class="pill" onclick="selPill(this,'platform','instagram')">Instagram</button>
      <button class="pill" onclick="selPill(this,'platform','tiktok')">TikTok</button>
      <button class="pill" onclick="selPill(this,'platform','pinterest')">Pinterest</button>
      <button class="pill" onclick="selPill(this,'platform','facebook')">Facebook Ads</button>
      <button class="pill" onclick="selPill(this,'platform','web')">Página Web</button>
    </div>
  </div>

  <!-- STEP 3: PRODUCT DETAILS (dynamic) -->
  <div class="card" id="step3">
    <div class="step-label"><div class="step-num sn3">3</div><div><div class="step-title">Detalles del producto</div><div class="step-sub">Opciones específicas según tu producto</div></div></div>
    <hr class="divider">

    <!-- NOTEBOOK -->
    <div class="dyn show" id="dyn-notebook">
      <span class="mlbl">Tamaño del cuaderno</span>
      <div class="g2" style="margin-bottom:0">
        <button class="opt on" onclick="selGroup(this,'size','7.5 x 9.25 inches')"><span class="opt-ico">📓</span><span class="opt-lbl">Composition</span><span class="opt-sub">7.5 × 9.25 in</span></button>
        <button class="opt" onclick="selGroup(this,'size','8.5 x 8.5 inches')"><span class="opt-ico">📒</span><span class="opt-lbl">Square</span><span class="opt-sub">8.5 × 8.5 in</span></button>
        <button class="opt" onclick="selGroup(this,'size','custom')"><span class="opt-ico">✏️</span><span class="opt-lbl">Custom Size</span><span class="opt-sub">Tu medida</span></button>
      </div>
      <div id="cbox-notebook" class="cbox"><div class="crow"><div class="ig"><label>Ancho</label><input type="number" id="cw" placeholder="0.0" step="0.1" oninput="convertSize()"></div><div class="sep">×</div><div class="ig"><label>Alto</label><input type="number" id="ch" placeholder="0.0" step="0.1" oninput="convertSize()"></div><div class="ig" style="max-width:100px"><label>Unidad</label><div class="utog"><button class="ubtn on" id="btnIn" onclick="setUnit('in')">in</button><button class="ubtn" id="btnCm" onclick="setUnit('cm')">cm</button></div></div></div><div id="cres" class="cres"></div></div>
    </div>

    <!-- BOOK -->
    <div class="dyn" id="dyn-book">
      <span class="mlbl">Tamaño del libro</span>
      <div class="g2">
        <button class="opt on" onclick="selGroup(this,'size','6 x 9 inches')"><span class="opt-ico">📗</span><span class="opt-lbl">Standard Book</span><span class="opt-sub">6 × 9 in</span></button>
        <button class="opt" onclick="selGroup(this,'size','8.5 x 11 inches')"><span class="opt-ico">📘</span><span class="opt-lbl">Large Book</span><span class="opt-sub">8.5 × 11 in</span></button>
        <button class="opt" onclick="selGroup(this,'size','5 x 8 inches')"><span class="opt-ico">📙</span><span class="opt-lbl">Small Book</span><span class="opt-sub">5 × 8 in</span></button>
        <button class="opt" onclick="selGroup(this,'size','custom')"><span class="opt-ico">✏️</span><span class="opt-lbl">Custom Size</span><span class="opt-sub">Tu medida</span></button>
      </div>
    </div>

    <!-- TSHIRT -->
    <div class="dyn" id="dyn-tshirt">
      <span class="mlbl">Marca</span>
      <div class="g4" style="margin-bottom:16px">
        <button class="opt on" onclick="selGroup(this,'brand','Bella Canvas')"><span class="opt-ico">✨</span><span class="opt-lbl">Bella Canvas</span></button>
        <button class="opt" onclick="selGroup(this,'brand','Comfort Colors')"><span class="opt-ico">🎨</span><span class="opt-lbl">Comfort Colors</span></button>
        <button class="opt" onclick="selGroup(this,'brand','Gildan')"><span class="opt-ico">👕</span><span class="opt-lbl">Gildan</span></button>
        <button class="opt" onclick="selGroup(this,'brand','Next Level')"><span class="opt-ico">⭐</span><span class="opt-lbl">Next Level</span></button>
      </div>
      <span class="mlbl">Color de la camiseta</span>
      <div class="swatch-row">
        <div><button class="swatch on" style="background:#fff;border-color:var(--dark)" onclick="selSwatch(this,'White')"></button><span class="swatch-label">Blanco</span></div>
        <div><button class="swatch" style="background:#1a1a1a" onclick="selSwatch(this,'Black')"></button><span class="swatch-label">Negro</span></div>
        <div><button class="swatch" style="background:#9ca3af" onclick="selSwatch(this,'Gray')"></button><span class="swatch-label">Gris</span></div>
        <div><button class="swatch" style="background:#1e3a5f" onclick="selSwatch(this,'Navy Blue')"></button><span class="swatch-label">Marino</span></div>
        <div><button class="swatch" style="background:#c0392b" onclick="selSwatch(this,'Red')"></button><span class="swatch-label">Rojo</span></div>
      </div>
    </div>

    <!-- HOODIE -->
    <div class="dyn" id="dyn-hoodie">
      <span class="mlbl">Marca</span>
      <div class="g4" style="margin-bottom:16px">
        <button class="opt on" onclick="selGroup(this,'brand','Bella Canvas')"><span class="opt-ico">✨</span><span class="opt-lbl">Bella Canvas</span></button>
        <button class="opt" onclick="selGroup(this,'brand','Comfort Colors')"><span class="opt-ico">🎨</span><span class="opt-lbl">Comfort Colors</span></button>
        <button class="opt" onclick="selGroup(this,'brand','Gildan')"><span class="opt-ico">🧥</span><span class="opt-lbl">Gildan</span></button>
        <button class="opt" onclick="selGroup(this,'brand','Next Level')"><span class="opt-ico">⭐</span><span class="opt-lbl">Next Level</span></button>
      </div>
      <span class="mlbl">Color del hoodie</span>
      <div class="swatch-row">
        <div><button class="swatch on" style="background:#fff;border-color:var(--dark)" onclick="selSwatch(this,'White')"></button><span class="swatch-label">Blanco</span></div>
        <div><button class="swatch" style="background:#1a1a1a" onclick="selSwatch(this,'Black')"></button><span class="swatch-label">Negro</span></div>
        <div><button class="swatch" style="background:#9ca3af" onclick="selSwatch(this,'Gray')"></button><span class="swatch-label">Gris</span></div>
        <div><button class="swatch" style="background:#1e3a5f" onclick="selSwatch(this,'Navy Blue')"></button><span class="swatch-label">Marino</span></div>
        <div><button class="swatch" style="background:#c0392b" onclick="selSwatch(this,'Red')"></button><span class="swatch-label">Rojo</span></div>
      </div>
    </div>

    <!-- MUG -->
    <div class="dyn" id="dyn-mug">
      <span class="mlbl">Estilo de taza</span>
      <div class="g2">
        <button class="opt on" onclick="selGroup(this,'mugstyle','classic white ceramic mug')"><span class="opt-ico">☕</span><span class="opt-lbl">Blanca clásica</span><span class="opt-sub">Classic white</span></button>
        <button class="opt" onclick="selGroup(this,'mugstyle','black interior ceramic mug')"><span class="opt-ico">🖤</span><span class="opt-lbl">Interior negro</span><span class="opt-sub">Black inside</span></button>
        <button class="opt" onclick="selGroup(this,'mugstyle','color-changing magic mug')"><span class="opt-ico">✨</span><span class="opt-lbl">Mágica</span><span class="opt-sub">Color reveal</span></button>
        <button class="opt" onclick="selGroup(this,'mugstyle','tall latte mug')"><span class="opt-ico">🥛</span><span class="opt-lbl">Tall / Latte</span><span class="opt-sub">Alto estilo café</span></button>
      </div>
    </div>

    <!-- STICKER -->
    <div class="dyn" id="dyn-sticker">
      <span class="mlbl">Forma del sticker</span>
      <div class="g3">
        <button class="opt on" onclick="selGroup(this,'stickerform','die-cut sticker following the exact shape and border of the uploaded design')"><span class="opt-ico">✂️</span><span class="opt-lbl">Die Cut</span><span class="opt-sub">Respeta el borde</span></button>
        <button class="opt" onclick="selGroup(this,'stickerform','circular round sticker')"><span class="opt-ico">⭕</span><span class="opt-lbl">Circular</span><span class="opt-sub">Round shape</span></button>
        <button class="opt" onclick="selGroup(this,'stickerform','square sticker')"><span class="opt-ico">⬜</span><span class="opt-lbl">Cuadrado</span><span class="opt-sub">Square shape</span></button>
      </div>
    </div>

    <!-- TOTE BAG -->
    <div class="dyn" id="dyn-totebag">
      <span class="mlbl">Color de la bolsa</span>
      <div class="swatch-row">
        <div><button class="swatch on" style="background:#f5f0e8;border-color:var(--dark)" onclick="selSwatch(this,'natural canvas')"></button><span class="swatch-label">Natural</span></div>
