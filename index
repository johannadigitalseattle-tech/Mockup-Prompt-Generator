</div>

<script>
var S = {
  product:'notebook', platform:'amazon',
  size:'7.5 x 9.25 inches', brand:'Bella Canvas', shirtColor:'White',
  mugstyle:'classic white ceramic mug', stickerform:'die-cut sticker following the exact shape and border of the uploaded design',
  candletype:'glass jar candle with label',
  scene:'a warm boho living room with natural plants, macrame wall decor and soft window light',
  action:'holding the product up with both hands at chest level displaying the front cover clearly',
  char:'hands', ethnicity:'Latina', skin:'light skin tone',
  palette:'background colors and props should subtly complement and harmonize with the product colors',
  unit:'in', customW:'', customH:''
};

var PROD_LABELS = {
  notebook:'composition notebook',book:'book',tshirt:'t-shirt',hoodie:'hoodie',
  mug:'mug',sticker:'sticker',totebag:'tote bag',candle:'candle'
};

function selProd(btn, val) {
  btn.closest('.g4').querySelectorAll('.opt').forEach(function(b){b.classList.remove('on')});
  btn.classList.add('on');
  S.product = val;
  // hide all dyn sections
  document.querySelectorAll('.dyn').forEach(function(d){d.classList.remove('show')});
  // show relevant ones
  var dyn = document.getElementById('dyn-'+val);
  if(dyn) dyn.classList.add('show');
  var sc = document.getElementById('scene-'+val);
  if(sc) sc.classList.add('show'); else { var sf = document.getElementById('scene-notebook'); if(sf) sf.classList.add('show'); }
  var ac = document.getElementById('action-'+val);
  if(ac) ac.classList.add('show'); else { var af = document.getElementById('action-notebook'); if(af) af.classList.add('show'); }
  // reset scene/action to first option
  ['scene-'+val,'action-'+val].forEach(function(id){
    var el = document.getElementById(id);
    if(el){
      var btns = el.querySelectorAll('.opt');
      btns.forEach(function(b){b.classList.remove('on')});
      if(btns[0]){btns[0].classList.add('on'); btns[0].click();}
    }
  });
}

function selPill(btn, group, val) {
  btn.closest('.pill-row').querySelectorAll('.pill').forEach(function(b){b.classList.remove('on')});
  btn.classList.add('on');
  S[group] = val;
}

function selGroup(btn, key, val) {
  var parent = btn.parentElement;
  parent.querySelectorAll('.opt').forEach(function(b){b.classList.remove('on')});
  btn.classList.add('on');
  S[key] = val;
  if(key==='size' && val==='custom'){
    var nb = document.getElementById('cbox-notebook');
    if(nb) nb.classList.add('show');
  } else if(key==='size'){
    var nb2 = document.getElementById('cbox-notebook');
    if(nb2) nb2.classList.remove('show');
  }
}

function selSwatch(btn, color) {
  btn.closest('.swatch-row').querySelectorAll('.swatch').forEach(function(b){b.classList.remove('on')});
  btn.classList.add('on');
  S.shirtColor = color;
}

function selChar(btn, val) {
  btn.closest('.g4').querySelectorAll('.opt').forEach(function(b){b.classList.remove('on')});
  btn.classList.add('on');
  S.char = val;
  var es = document.getElementById('ethnicitySection');
  es.style.display = (val === 'hands') ? 'none' : 'block';
}

function selSkin(btn, val) {
  btn.closest('.skin-row').querySelectorAll('.skin').forEach(function(b){b.classList.remove('on')});
  btn.classList.add('on');
  S.skin = val;
}

function setUnit(u) {
  S.unit = u;
  document.getElementById('btnIn').classList.toggle('on', u==='in');
  document.getElementById('btnCm').classList.toggle('on', u==='cm');
  convertSize();
}

function convertSize() {
  var w = parseFloat(document.getElementById('cw').value);
  var h = parseFloat(document.getElementById('ch').value);
  var res = document.getElementById('cres');
  if(!w||!h){res.classList.remove('show');return;}
  if(S.unit==='cm'){
    S.customW=(w/2.54).toFixed(2); S.customH=(h/2.54).toFixed(2);
    res.textContent='✓ En pulgadas: '+S.customW+' × '+S.customH+' inches';
  } else {
    S.customW=w.toFixed(2); S.customH=h.toFixed(2);
    res.textContent='✓ Tamaño: '+S.customW+' × '+S.customH+' inches';
  }
  res.classList.add('show');
  S.size = S.customW+' x '+S.customH+' inches';
}

function getProductDetail() {
  var p = S.product;
  if(p==='notebook'||p==='book') return 'The product is a '+PROD_LABELS[p]+' measuring '+S.size+' — real-life size, do NOT make it look oversized or like a poster.';
  if(p==='tshirt') return 'The product is a '+S.shirtColor+' '+S.brand+' t-shirt.';
  if(p==='hoodie') return 'The product is a '+S.shirtColor+' '+S.brand+' hoodie.';
  if(p==='mug') return 'The product is a '+S.mugstyle+'.';
  if(p==='sticker') return 'The product is a '+S.stickerform+'.';
  if(p==='totebag') return 'The product is a '+S.shirtColor+' tote bag.';
  if(p==='candle') return 'The product is a '+S.candletype+'.';
  return 'The product is a '+PROD_LABELS[p]+'.';
}

function getCharDesc() {
  if(S.char==='hands') return 'A pair of hands';
  var ages = {girl:'5 to 8 year old',boy:'5 to 8 year old','teen-girl':'13 to 17 year old','teen-boy':'13 to 17 year old',woman:'adult',man:'adult'};
  var genders = {girl:'girl',boy:'boy','teen-girl':'girl','teen-boy':'boy',woman:'woman',man:'man'};
  return 'A '+ages[S.char]+' '+S.ethnicity+' '+genders[S.char]+' with '+S.skin;
}

var CRITICAL = 'CRITICAL: Use the uploaded reference image as the exact product cover/design. Do NOT redesign, recolor, reinterpret, simplify or modify it in any way. Reproduce it exactly as uploaded. Preserve original artwork 100%.';

function generate() {
  var prodDetail = getProductDetail();
  var charDesc = getCharDesc();
  var scene = S.scene;
  var action = S.action;
  var palette = S.palette;

  // GEMINI - no minors
  var geminiChar = (S.char==='girl'||S.char==='boy') ? 'A pair of hands' : charDesc;
  var geminiPrompt =
    'Hyper-realistic professional product photography.\n'+
    geminiChar+' '+action+'.\n\n'+
    'Setting: '+scene+'.\n'+
    prodDetail+'\n'+
    'Scene colors: '+palette+'.\n\n'+
    'Camera: 85mm lens, shallow depth of field, soft natural light, DSLR quality, 8K resolution.\n\n'+
    CRITICAL;

  // GROK / CHATGPT
  var grokPrompt =
    'Hyper-realistic professional product photography.\n'+
    charDesc+' '+action+'.\n\n'+
    'Setting: '+scene+'.\n'+
    prodDetail+'\n'+
    'Scene colors: '+palette+'.\n\n'+
    'Camera: 85mm lens, shallow depth of field, cinematic natural light, DSLR professional photography, 8K resolution, ultra-detailed textures.\n\n'+
    CRITICAL;

  // MIDJOURNEY
  var mjPrompt =
    'Hyper-realistic product photography, '+
    charDesc+' '+action+', '+
    scene+', '+
    prodDetail.replace(/\n/g,' ')+', '+
    palette+', '+
    '85mm lens, shallow depth of field, cinematic lighting, DSLR, 8K, photorealistic --v 6.1 --ar 4:5 --q 2\n\n'+
    '⚠️ Agrega al final: --cref [URL de tu imagen de producto]';

  document.getElementById('pt-gemini').textContent = geminiPrompt;
  document.getElementById('pt-grok').textContent = grokPrompt;
  document.getElementById('pt-mj').textContent = mjPrompt;

  var r = document.getElementById('results');
  r.classList.add('show');
  r.scrollIntoView({behavior:'smooth',block:'start'});
}

function cp(id, btn) {
  navigator.clipboard.writeText(document.getElementById(id).textContent).then(function(){
    var orig = btn.innerHTML;
    btn.innerHTML = '✓ ¡Copiado!';
    setTimeout(function(){btn.innerHTML=orig;},2000);
  });
}
</script>
</body>
</html>
