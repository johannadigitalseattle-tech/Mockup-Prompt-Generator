      <button class="cpbtn cp-c" onclick="cp('pt-grok',this)">📋 Copiar prompt</button>
    </div>

    <div class="pcard pc-mj">
      <div class="pbadge bg-y">✦ Midjourney</div>
      <div class="ptitle">Para Midjourney</div>
      <div class="pdesc">Agrega --cref [url de tu imagen] al final</div>
      <div class="ptext" id="pt-mj"></div>
      <button class="cpbtn cp-y" onclick="cp('pt-mj',this)">📋 Copiar prompt</button>
    </div>
  </div>

</div>

